[Unit]
Description=Caisse Bluebird — agent d'impression des bons de cuisine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caisse-print
Group=caisse-print
# `lp` donne l'accès à /dev/usb/lp0 (imprimante USB).
SupplementaryGroups=lp
WorkingDirectory=/opt/caisse-print
EnvironmentFile=/etc/caisse-print.env
ExecStart=/usr/bin/node /opt/caisse-print/print-agent.js
Restart=always
RestartSec=5

# Cloisonnement : l'agent n'écrit que son fichier d'état.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caisse-print

[Install]
WantedBy=multi-user.target
