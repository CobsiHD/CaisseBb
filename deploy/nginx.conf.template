# Caisse Bluebird — site statique + API de synchronisation.
# __DOMAIN__ est remplacé par le nom de domaine à l'installation.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/caisse-bluebird;
    index index.html;

    client_max_body_size 16m;
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    # ── Première serrure : rien de l'appli ne se télécharge sans mot de passe ──
    # Posée au niveau du serveur, donc héritée par TOUS les blocs `location`
    # ci-dessous (contrairement à `add_header`, `auth_basic` s'hérite bien).
    # Le fichier est écrit par setup-vps.sh à partir de CAISSE_PASSWORD :
    # une seule et même phrase pour la serrure nginx et pour l'appli.
    # La seconde serrure est dans l'appli elle-même (js/gate.js).
    #
    # Deux exceptions, toutes deux volontaires — voir les `auth_basic off`
    # ci-dessous : la vérification Let's Encrypt et l'API de synchronisation.
    auth_basic "Caisse Bluebird";
    auth_basic_user_file /etc/nginx/caisse-bluebird.htpasswd;

    # Renouvellement du certificat, laissé OUVERT. Ce bloc `^~` a priorité sur
    # celui que certbot insère au moment du renouvellement : c'est donc lui qui
    # sert la vérification, et fermé il ferait expirer le certificat — ce qui
    # couperait tout le bar. setup-vps.sh le vérifie par un
    # `certbot renew --dry-run` juste après avoir posé la serrure.
    location ^~ /.well-known/acme-challenge/ { auth_basic off; root /var/www/html; }

    # L'appli n'a pas d'étape de build : les URL des modules ne changent jamais
    # d'un déploiement au suivant. Sans revalidation obligatoire, Safari applique
    # sa fraîcheur heuristique et peut resservir un ancien module — l'appli
    # démarre alors avec un mélange de versions et l'import échoue.
    # `add_header` ne s'additionne pas à celui du serveur : il le REMPLACE. On
    # répète donc les en-têtes de sécurité dans chaque bloc qui en pose un.
    location ~* ^/(js|css)/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
    location = /service-worker.js {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
    # Chrome ne remplace l'icône d'une PWA installée que s'il voit le manifeste
    # changer. Servi depuis un cache heuristique, il ne le voit jamais, et
    # l'ancienne icône reste gravée dans le lanceur Android.
    # nginx ne connaît pas l'extension .webmanifest et servait le fichier en
    # application/octet-stream : avec le nosniff ci-dessous, le navigateur a le
    # droit de refuser de le lire, et l'appli s'installe sans son manifeste.
    location = /manifest.webmanifest {
        types { } default_type application/manifest+json;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API de synchronisation (serveur Node local).
    location /api/ {
        # Pas de mot de passe nginx ici : l'API a le sien (jeton signé), et
        # l'agent d'impression du Pi ne sait pas envoyer d'identifiants HTTP.
        # Sans jeton valide, /api/pull, /api/push et /api/events répondent 401
        # (vérifié en production le 2026-09-04).
        auth_basic off;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Flux temps réel (SSE) : pas de tampon, connexion longue.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
