# Caisse Bluebird — site statique + API de synchronisation.
# __DOMAIN__ est remplacé par le nom de domaine à l'installation.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/caisse-bluebird;
    index index.html;

    client_max_body_size 16m;
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    # L'appli et le service worker doivent toujours être frais : sinon les iPads
    # restent bloqués sur une ancienne version après un déploiement.
    location = /index.html        { add_header Cache-Control "no-cache"; }
    location = /service-worker.js { add_header Cache-Control "no-cache"; }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API de synchronisation (serveur Node local).
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Flux temps réel (SSE) : pas de tampon, connexion longue.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
