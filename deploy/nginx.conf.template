# Caisse Bluebird — site statique + API de synchronisation.
# __DOMAIN__ est remplacé par le nom de domaine à l'installation.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/caisse-bluebird;
    index index.html;

    client_max_body_size 16m;
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    # ── Première serrure : rien de l'appli ne se télécharge sans cookie valide ──
    # Posée au niveau du serveur, donc héritée par TOUS les blocs `location`
    # ci-dessous ; les exceptions sont des `auth_request off` explicites.
    #
    # Pourquoi un cookie et non l'authentification HTTP qu'on utilisait avant :
    # ajoutée à l'écran d'accueil, une PWA iPad n'affiche JAMAIS la fenêtre de
    # mot de passe native. Le 401 y devenait un écran blanc sans formulaire —
    # la caisse était inutilisable au lancement, tous les jours, et il fallait
    # repasser par Safari. Un cookie, lui, survit au mode plein écran.
    #
    # La seconde serrure reste dans l'appli elle-même (js/gate.js).
    auth_request /gate;
    error_page 401 = @connexion;

    # Sous-requête interne : le serveur Node lit le cookie et répond 204 ou 401.
    # `internal` — inatteignable depuis l'extérieur.
    location = /gate {
        internal;
        auth_request off;
        proxy_pass http://127.0.0.1:8787/api/gate-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
    }

    # Sans cookie valide, on ENVOIE vers la page de connexion au lieu de rendre
    # un 401 nu : c'est toute la raison d'être de ce montage.
    location @connexion {
        return 302 /connexion.html;
    }

    # La porte de secours, forcément ouverte : derrière la serrure, elle
    # provoquerait une boucle de redirection. Jamais mise en cache non plus —
    # servie périmée, elle enfermerait dehors.
    location = /connexion.html {
        auth_request off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-store" always;
    }

    # Renouvellement du certificat, laissé OUVERT. Ce bloc `^~` a priorité sur
    # celui que certbot insère au moment du renouvellement : c'est donc lui qui
    # sert la vérification, et fermé il ferait expirer le certificat — ce qui
    # couperait tout le bar. setup-vps.sh le vérifie par un
    # `certbot renew --dry-run` juste après avoir posé la serrure.
    location ^~ /.well-known/acme-challenge/ { auth_request off; root /var/www/html; }

    # L'appli n'a pas d'étape de build : les URL des modules ne changent jamais
    # d'un déploiement au suivant. Sans revalidation obligatoire, Safari applique
    # sa fraîcheur heuristique et peut resservir un ancien module — l'appli
    # démarre alors avec un mélange de versions et l'import échoue.
    # `add_header` ne s'additionne pas à celui du serveur : il le REMPLACE. On
    # répète donc les en-têtes de sécurité dans chaque bloc qui en pose un.
    location ~* ^/(js|css)/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
    location = /service-worker.js {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
    # Chrome ne remplace l'icône d'une PWA installée que s'il voit le manifeste
    # changer. Servi depuis un cache heuristique, il ne le voit jamais, et
    # l'ancienne icône reste gravée dans le lanceur Android.
    # nginx ne connaît pas l'extension .webmanifest et servait le fichier en
    # application/octet-stream : avec le nosniff ci-dessous, le navigateur a le
    # droit de refuser de le lire, et l'appli s'installe sans son manifeste.
    location = /manifest.webmanifest {
        types { } default_type application/manifest+json;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API de synchronisation (serveur Node local).
    location /api/ {
        # Pas de serrure nginx ici : l'API a la sienne (jeton signé), et c'est
        # elle qui pose le cookie (/api/login) comme qui le vérifie
        # (/api/gate-check). L'y soumettre fermerait la porte de l'extérieur.
        # Sans jeton valide, /api/pull, /api/push et /api/events répondent 401.
        auth_request off;

        # Les 401 du serveur Node sont du JSON et doivent le rester : l'agent
        # d'impression et la synchro attendent une erreur, pas une page de
        # connexion. `proxy_intercept_errors` vaut off par défaut, donc le
        # `error_page 401` du serveur ne s'applique PAS aux réponses qui
        # viennent d'ici — ne surtout pas le réactiver.

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Flux temps réel (SSE) : pas de tampon, connexion longue.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
